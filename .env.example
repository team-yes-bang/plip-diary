# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

SERVER_PORT=8081
MYSQL_PORT=3308
MYSQL_DATABASE=plip_diary

# plip-net 컨테이너 DNS (통합 develop-env infra 와 동일 호스트명)
MYSQL_HOST=mysql
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
REDISINSIGHT_PORT=5540

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=plip_diary_read

# user 서비스 (로컬 통합 [L])
JWT_SECRET=change-me-local-dev-only

# Kafka topic (plip-topic·Kafka UI 기준 — diary.video.bound 는 topic-service Consumer 전용, diary Producer 아님)
APP_KAFKA_TOPICS_USER_REGISTERED=user.registered
APP_KAFKA_TOPICS_DIARY_VIDEO_UPLOADED=diary.video.uploaded
APP_KAFKA_TOPICS_DIARY_VIDEO_LINKED=diary.video.linked
APP_KAFKA_TOPICS_DIARY_VIDEO_UNLINKED=diary.video.unlinked

# 로컬 단독 compose: eureka 없음. 통합 develop-env 는 services.yml 에서 true override
EUREKA_CLIENT_ENABLED=false

# =============================================================================
# 실행 시나리오 (통합 develop-env 와 동일 plip-net · 서비스명 mysql/redis/kafka)
# =============================================================================
#
# [L] 로컬 통합 — user + diary 앱 + 공통 인프라 (Git 미추적 compose)
#   cp docker-compose.local.yml.example docker-compose.local.yml
#   cp docker/local/mysql/init-databases.sql.example docker/local/mysql/init-databases.sql
#   (plip-user 가 ../plip-user 형제 경로일 것)
#   up:   docker compose -f docker-compose.local.yml up -d --build
#   down: docker compose -f docker-compose.local.yml down
#   plip-user / plip-diary 단독 compose 는 내린 뒤 실행 (포트·plip-net 충돌 방지)
#   user 8080 · diary 8081 · DB plip_user + plip_diary · Mongo plip_diary_read
#
# [A] diary 만 개발 — infra + app 한 번에 (이 레포 단독)
#   up:   docker compose up -d --build
#   down: docker compose down
#   down (볼륨 포함 DB 초기화): docker compose down -v
#   코드 수정 반복 시 (아래 [W] watch 참고)
#
# [B] app 만 — plip-net infra 가 이미 실행 중 (develop-env infra 또는 [A]/[D]로 infra 기동 후)
#   up:   docker compose -f docker-compose.app.yml up -d --build
#   down: docker compose -f docker-compose.app.yml down
#   .env 호스트명 mysql/redis/kafka 유지 (plip-net DNS)
#
# [C] 통합 develop-env (Develop PC / 통합 테스트) — diary 레포 추가 수정 불필요
#   plip-develop-env 에 docker-compose.services.yml include 등록 후:
#   up:   docker compose -f docker-compose.infra.yml -f docker-compose.services.yml up -d --build diary
#   down: docker compose -f docker-compose.infra.yml -f docker-compose.services.yml stop diary
#         docker compose -f docker-compose.infra.yml -f docker-compose.services.yml rm -f diary
#   (EUREKA_CLIENT_ENABLED=true 는 develop-env services.yml environment override)
#
# [D] infra 만 — IDE bootRun
#   up:   docker compose up -d mysql redis kafka kafka-ui mongo redisinsight
#   down: docker compose stop mysql redis kafka kafka-ui mongo redisinsight
#   Kafka UI: http://localhost:${KAFKA_UI_PORT:-8090}
#   RedisInsight: http://localhost:${REDISINSIGHT_PORT:-5540} (연결: Host redis, Port 6379)
#   .env 에 호스트 접속:
#     MYSQL_HOST=localhost
#     REDIS_HOST=localhost
#     KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#     MONGO_HOST=localhost
#     MONGO_PORT=27017
#     application-local.yml: spring.mongodb.uri=mongodb://localhost:27017/plip_diary_read
#
# [W] 코드 수정 후 재기동 — down 없이 watch 권장 (Java 이미지 자동 rebuild)
#   1) 최초/의존성 변경: docker compose up -d --build
#   2) watch (foreground, -d 와 병용 불가):
#        docker compose watch
#      또는 한 번에: docker compose up --build --watch
#   watch 중단: Ctrl+C (컨테이너는 유지됨)
#   --build: Dockerfile·build.gradle·의존성 변경, 최초 기동, watch 미사용 시 필요
#   src/main 만 수정: watch 가 rebuild 하므로 매번 down/build/up 불필요
