# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8081
MYSQL_PORT=3308

# MySQL 스키마명 — 서비스별로 변경 (예: plip_agit)
MYSQL_DATABASE=plip_diary

# 로컬 Docker Compose 전용 — Compose가 app 컨테이너에 redis/kafka 호스트명을 주입
# 호스트 IDE bootRun 시: localhost + 아래 포트 (infra 컨테이너만 띄운 경우)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
