# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8081
MYSQL_PORT=3308

# MySQL 스키마명 — 서비스별로 변경 (예: plip_agit)
MYSQL_DATABASE=plip_diary

# app 단독 기동 시 user-service 공유 인프라 호스트명 (plip-user_default 네트워크 DNS)
# MYSQL_PORT(3308)는 호스트→컨테이너 포트 매핑용. 컨테이너 간 통신은 MySQL 3306 고정(application-docker.yml)
MYSQL_HOST=plip-user-mysql
REDIS_HOST=plip-user-redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=plip-user-kafka:9092
KAFKA_PORT=9092
